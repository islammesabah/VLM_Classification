**/src/datasets/CIFAR-10/
**/src/datasets/MNIST/
**/src/datasets/MSCOCO/
*.part

# ---- Staged run artifacts ----
# README stages the databases and derived CSVs into **/src/results/, which also
# holds tracked scripts -- so ignore the staged data, not the directory.
**/src/results/*.db
**/src/results/*.db-journal
**/src/results/baselines/
**/src/results/cot_baseline/
**/src/results/constrained_choice_probe/
**/src/results/global_list_probe/
