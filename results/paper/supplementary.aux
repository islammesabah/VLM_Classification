\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces Complete accuracy (\%) for every condition at both temperatures. ZS: zero-shot; +D: class and image descriptions injected into the prompt; +H: conversation history carried across tree nodes; CoT: chain-of-thought. Accuracy counts unparseable answers and images with no logged traversal as wrong, so every cell shares the denominator of its condition. Superscripts give $n$ for cells that did not complete a full dataset pass ($<90\%$ coverage); an em dash marks conditions with no logged rows. CoT was run at $T{=}0.7$ only, on a $n{=}100$ probe per dataset--model pair with full class coverage. Bold and underlined values denote the best and second-best result within each dataset--model--temperature row, considering only cells at full coverage. Full passes are $n=901$ (GTSRB), $1000$ (MNIST, CIFAR-10), and $850$ (MSCOCO).}}{2}{table.1}\protected@file@percent }
\newlabel{tab:supp_full}{{S1}{2}{Complete accuracy (\%) for every condition at both temperatures. ZS: zero-shot; +D: class and image descriptions injected into the prompt; +H: conversation history carried across tree nodes; CoT: chain-of-thought. Accuracy counts unparseable answers and images with no logged traversal as wrong, so every cell shares the denominator of its condition. Superscripts give $n$ for cells that did not complete a full dataset pass ($<90\%$ coverage); an em dash marks conditions with no logged rows. CoT was run at $T{=}0.7$ only, on a $n{=}100$ probe per dataset--model pair with full class coverage. Bold and underlined values denote the best and second-best result within each dataset--model--temperature row, considering only cells at full coverage. Full passes are $n=901$ (GTSRB), $1000$ (MNIST, CIFAR-10), and $850$ (MSCOCO)}{table.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {S4}Ten-Prompt Zero-Shot Sweep}{2}{section.4}\protected@file@percent }
\newlabel{sec:supp_prompts}{{S4}{2}{Ten-Prompt Zero-Shot Sweep}{section.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Prompt sensitivity is large, not small.}{2}{section*.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Prompt~0 is the strongest GTSRB prompt, not a typical one.}{2}{section*.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces Paired bootstrap over images for the tree-minus-zero-shot accuracy gap at $T{=}0.7$ (no descriptions, no history, run~0). Zero-shot and tree predictions share an image row, so images are resampled with replacement ($10{,}000$ resamples, seed~42) and both accuracies are recomputed on each resample. $\Delta $ is Tree$-$ZS in points; the interval is the $2.5$--$97.5$ percentile range of the resampled $\Delta $. $p_{\text  {Holm}}$ is the two-sided bootstrap $p$ after Holm--Bonferroni correction over all twelve dataset--model comparisons. Entries marked $<$ are floored by bootstrap resolution and are upper bounds. Every comparison is negative and every corrected $p$ clears $\alpha =0.05$.}}{3}{table.2}\protected@file@percent }
\newlabel{tab:supp_bootstrap}{{S2}{3}{Paired bootstrap over images for the tree-minus-zero-shot accuracy gap at $T{=}0.7$ (no descriptions, no history, run~0). Zero-shot and tree predictions share an image row, so images are resampled with replacement ($10{,}000$ resamples, seed~42) and both accuracies are recomputed on each resample. $\Delta $ is Tree$-$ZS in points; the interval is the $2.5$--$97.5$ percentile range of the resampled $\Delta $. $p_{\text {Holm}}$ is the two-sided bootstrap $p$ after Holm--Bonferroni correction over all twelve dataset--model comparisons. Entries marked $<$ are floored by bootstrap resolution and are upper bounds. Every comparison is negative and every corrected $p$ clears $\alpha =0.05$}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces Zero-shot accuracy for each of the ten prompt paraphrases, on the dataset--model pairs swept at full scale. Prompt~0, reported in Table~1 of the main paper, is the best of the ten on GTSRB for all three models.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:supp_prompt_sweep}{{S1}{3}{Zero-shot accuracy for each of the ten prompt paraphrases, on the dataset--model pairs swept at full scale. Prompt~0, reported in Table~1 of the main paper, is the best of the ten on GTSRB for all three models}{figure.1}{}}
