\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces Zero-shot accuracy (\%) for each of the ten prompt paraphrases at $T{=}0.7$, on the datasets where every prompt was run at full scale. P0 is the prompt reported in Table~1 of the main paper. Empty cells are prompts whose run did not reach full coverage and are excluded from the summary statistics. $\Delta $ is $\max -\min $ across prompts.}}{4}{table.3}\protected@file@percent }
\newlabel{tab:supp_prompt_sweep}{{S3}{4}{Zero-shot accuracy (\%) for each of the ten prompt paraphrases at $T{=}0.7$, on the datasets where every prompt was run at full scale. P0 is the prompt reported in Table~1 of the main paper. Empty cells are prompts whose run did not reach full coverage and are excluded from the summary statistics. $\Delta $ is $\max -\min $ across prompts}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces Small-scale prompt checks on the datasets without a full-scale sweep. Each row compares the prompts that were run on the same matched image subset, so the spread is not confounded by which images each prompt saw.}}{4}{table.4}\protected@file@percent }
\newlabel{tab:supp_matched_prompts}{{S4}{4}{Small-scale prompt checks on the datasets without a full-scale sweep. Each row compares the prompts that were run on the same matched image subset, so the spread is not confounded by which images each prompt saw}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces Global-label probe with GPT-4o, on the images both conditions share. Local is the standard node prompt; Global appends the dataset's full class list to every node prompt. All values are percentages.}}{4}{table.5}\protected@file@percent }
\newlabel{tab:supp_global}{{S5}{4}{Global-label probe with GPT-4o, on the images both conditions share. Local is the standard node prompt; Global appends the dataset's full class list to every node prompt. All values are percentages}{table.5}{}}
