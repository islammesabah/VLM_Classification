# Copy to .env and fill in. Only the keys for the models you run are needed.

# --- API keys ---

# GPT-4o (OpenRouter); also the automated tree generation pipeline when its
# --backend is openrouter.
OPENROUTER_API_KEY=

# Qwen-VL-Max (Alibaba DashScope, OpenAI-compatible endpoint)
ALIBABA_API_KEY=

# Automated tree generation only, when its --backend is openai
OPENAI_API_KEY=

# --- Endpoints ---
# The two hosted providers fall back to the defaults shown below when unset;
# override only to point at a proxy, a region-specific host, or a replay server.

# GPT-4o. Default: https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# Qwen-VL-Max. Default: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ALIBABA_BASE_URL=

# Self-hosted Ollama endpoint serving llama3.2-vision:11b-instruct-fp16.
# Required -- there is no default. e.g. http://localhost:11434/v1
OLLAMA_BASE_URL=

# Optional OpenRouter attribution headers used by the tree generator
APP_URL=
APP_NAME=
